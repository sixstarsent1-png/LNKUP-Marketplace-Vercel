{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.1",
  "port": 8888,
  "testsPort": 8889,
  "plugins": ["./wp-content/plugins/lnkup-marketplace", "./wp-content/plugins/lnkup-communications"],
  "themes": ["./wp-content/themes/lnkup-theme"],
  "mappings": {
    "wp-content/lnkup-e2e": "./scripts/e2e"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "LNKUP_ALLOW_PAYMENT_SIMULATION": true,
    "WP_ENVIRONMENT_TYPE": "local"
  }
}
