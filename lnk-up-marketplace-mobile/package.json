{
  "name": "lnk-up-marketplace-mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "^57.0.1",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:development": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "update:preview": "npx --yes cross-env EXPO_PUBLIC_LNKUP_LIVE_API=true EXPO_PUBLIC_WORDPRESS_API_URL=https://thelnkup.com npx --yes eas-cli update --channel preview --environment preview --message \"Preview OTA\" --non-interactive",
    "update:production": "npx --yes cross-env EXPO_PUBLIC_LNKUP_LIVE_API=true EXPO_PUBLIC_WORDPRESS_API_URL=https://thelnkup.com npx --yes eas-cli update --channel production --environment production --message \"Production OTA\" --non-interactive",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "web:e2e": "npx --yes cross-env EXPO_PUBLIC_LNKUP_LIVE_API=true EXPO_PUBLIC_WORDPRESS_API_URL=http://localhost:8888 EXPO_PUBLIC_LNKUP_API_TIMEOUT_MS=45000 BROWSER=none expo start --web --port 8081",
    "ui-polish:verify": "node scripts/ui-polish-verify.mjs",
    "phase20:verify": "npm run typecheck && node scripts/phase20-verify.mjs && node scripts/fixture-honesty-verify.mjs && node scripts/ui-polish-verify.mjs",
    "phase23:verify": "npm run typecheck && node scripts/phase23-verify.mjs",
    "phase24:verify": "npm run typecheck && node scripts/phase24-verify.mjs",
    "phase26:verify": "npm run typecheck && node scripts/phase26-verify.mjs",
    "phase27:verify": "npm run typecheck && node scripts/phase27-verify.mjs",
    "device-smoke:verify": "node scripts/device-smoke-verify.mjs",
    "store-preflight:verify": "node scripts/store-preflight-verify.mjs",
    "doctor": "npx expo-doctor",
    "icons": "node scripts/generate-native-icons.mjs",
    "push:ios": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push-ios.ps1"
  },
  "private": true
}
