{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test tests/e2e/marketplace-v2.spec.ts",
    "e2e:env": "npx -y @wordpress/env@10 start",
    "e2e:env:stop": "npx -y @wordpress/env@10 stop",
    "e2e:seed": "npx -y @wordpress/env@10 run cli wp eval-file /var/www/html/wp-content/lnkup-e2e/seed.php",
    "e2e:lint": "npx -y @wordpress/env@10 run cli php /var/www/html/wp-content/lnkup-e2e/lint.php",
    "e2e:run": "powershell -NoProfile -File scripts/e2e/run-specs.ps1",
    "test:comms:php": "powershell -NoProfile -File scripts/e2e/run-comms-php.ps1",
    "test:fin:php": "powershell -NoProfile -File scripts/e2e/run-financial-php.ps1",
    "test:apps:php": "powershell -NoProfile -File scripts/e2e/run-applications-php.ps1",
    "test:e2e:app": "playwright test --project=lnkup-app",
    "test:e2e:app:mobile": "playwright test --project=lnkup-app-mobile",
    "phase15-20:report": "node scripts/qa/phase15-20-gate-report.mjs",
    "phase22:report": "node scripts/qa/phase15-20-gate-report.mjs",
    "phase20:verify": "npm --prefix lnk-up-marketplace-mobile run phase20:verify",
    "phase27:verify": "node scripts/phase27-verify.mjs && npm --prefix lnk-up-marketplace-mobile run phase27:verify",
    "test:passport:php": "npx.cmd -y @wordpress/env@10 run cli wp eval-file wp-content/lnkup-e2e/php/vendor-passport-test.php",
    "organizer-vendor-profile:verify": "node scripts/organizer-vendor-profile-enrichment-verify.mjs",
    "find-media-wallet:verify": "node scripts/find-media-wallet-verify.mjs",
    "money-path:verify": "node scripts/money-path-verify.mjs",
    "money-path:smoke": "node scripts/live-wp-money-path-smoke.mjs",
    "gap-close:verify": "node scripts/gap-close-verify.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}