# LNKup Marketplace — Meta measurement configuration (placeholders only).
#
# Never commit real tokens. On SiteGround (no process env), define these in wp-config.php
# instead, e.g.  define( 'LNKUP_META_CAPI_ACCESS_TOKEN', '...' );
# The bare names (META_CAPI_ACCESS_TOKEN) are also accepted as constants.
# Environment values and constants override the wp-admin "Meta Integration" settings.

META_DATASET_ID=2099891494063746
META_PIXEL_ID=2099891494063746
META_AD_ACCOUNT_ID=405302106865918

# Secrets: server-only. Leave blank here.
META_CAPI_ACCESS_TOKEN=
# Optional: falls back to META_CAPI_ACCESS_TOKEN (Events Manager tokens can read dataset quality).
META_DATASET_QUALITY_ACCESS_TOKEN=
# Optional, read-only (ads_read). Used for ad account access checks only in this release.
META_MARKETING_API_ACCESS_TOKEN=

# Defaults to v27.0. Must be v25.0 or newer.
META_GRAPH_API_VERSION=v27.0
# From Events Manager > Test events. Required when META_TEST_MODE=true.
META_TEST_EVENT_CODE=

# Safe defaults: everything off until verified. Internal recording is always on.
META_PIXEL_ENABLED=false
META_CAPI_ENABLED=false
META_DATASET_QUALITY_ENABLED=false
META_MARKETING_API_ENABLED=false
META_APP_EVENTS_ENABLED=false
META_TEST_MODE=false
